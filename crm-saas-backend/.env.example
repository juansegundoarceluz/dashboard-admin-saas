# Copia este archivo a .env y completa los valores.
# NO commitear el archivo .env real.

# Servidor
PORT=3001
NODE_ENV=development

# Base de datos PostgreSQL (Prisma)
DATABASE_URL="postgresql://user:password@localhost:5432/crm_saas?schema=public"

# JWT
# Generar uno aleatorio fuerte con:  openssl rand -hex 32
JWT_SECRET=replace-with-a-random-32-byte-hex-string
JWT_EXPIRES_IN=1d
